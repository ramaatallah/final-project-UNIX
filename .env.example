# =============================================================================
# .env.example – Template for environment variables
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file to `.env`  (cp .env.example .env)
#   2. Fill in the real values
#   3. NEVER commit `.env` to Git (it is in .gitignore)
# =============================================================================

# MySQL root password (used only by the MySQL container internally)
MYSQL_ROOT_PASSWORD=change_me_root

# Application user credentials (used by both db and backend containers)
MYSQL_USER=appuser
MYSQL_PASSWORD=change_me_app

# Database name
MYSQL_DATABASE=recommendation_db
