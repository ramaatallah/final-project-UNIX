# =============================================================================
# .dockerignore – Exclude unnecessary files from the Docker build context
# Applies to: entire project root (used by backend/Dockerfile)
# Smaller context = faster builds and smaller images
# =============================================================================

# Version control
.git
.gitignore

# Node modules (reinstalled fresh inside the image via npm ci)
node_modules
**/node_modules

# Logs
*.log
npm-debug.log*

# OS artifacts
.DS_Store
Thumbs.db

# Editor directories
.vscode
.idea
*.swp
*.swo

# Environment files (never bake secrets into images!)
.env
.env.*
!.env.example

# CI/CD files (not needed at runtime)
Jenkinsfile

# Database init scripts are mounted as a volume, not baked in
# (optional – comment out if you want the SQL inside the image)
# database/
